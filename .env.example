# AGENTROUTER_API_KEY: Required server-side API key for AgentRouter requests.
# Obtain this from your AgentRouter provider / console.
# NEVER expose this key in client-side code, HTML, or browser variables.
AGENTROUTER_API_KEY=

# OPTIONAL: Customize the AgentRouter base URL (defaults to https://co.agentrouter.org/v1)
# AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1

# Port to run the server on (default: 3000)
PORT=3000
